{
  "name": "seedha-kaam",
  "version": "2.0.0",
  "private": false,
  "description": "Showcase repo for Build What Moves India — Bengaluru khata transfer pre-flight prototype. No API keys on deploy. Synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/engine.test.js",
    "check": "npm run test && npm run build"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^5.1.0",
    "pdfkit": "^0.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.10"
  }
}
